{
  "version": 2,
  "buildCommand": "cd j-apprends-a-cuisiner && npm install && npm run build",
  "outputDirectory": "j-apprends-a-cuisiner/dist",
  "framework": null,
  "installCommand": "npm install",
  "functions": {
    "api/**/*.js": {
      "memory": 512,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
