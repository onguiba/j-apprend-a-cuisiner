# URL de l'API Backend (laisser vide ou mettre l'URL de votre backend déployé)
VITE_API_URL=https://votre-backend.railway.app/api

# Mode de données
# "api" = utiliser le backend (nécessite un serveur backend déployé)
# "local" = utiliser DataService (données en mémoire, pas de backend requis)
VITE_DATA_MODE=local
