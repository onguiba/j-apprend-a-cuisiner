# URL de l'API Backend
# En production (Vercel) : utiliser le chemin relatif /api
# En développement local : utiliser http://localhost:3000/api si vous avez un backend local ou /api
VITE_API_URL=/api

# Mode de données
# "api" = utiliser le backend (recommandé en production, nécessite PostgreSQL)
# "local" = utiliser DataService (données en mémoire, pas de backend requis)
VITE_DATA_MODE=api
