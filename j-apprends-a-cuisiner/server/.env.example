# ═══════════════════════════════════════════════════
# SAVEURS DU CAMEROUN — Variables d'environnement
# Copiez ce fichier en .env et remplissez vos valeurs
# ═══════════════════════════════════════════════════

# ── Serveur ─────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────
# Remplacez par vos vraies informations de connexion
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saveurs_cameroun
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe_postgres

# ── JWT ──────────────────────────────────────────────
# Générez une clé secrète longue et aléatoire
JWT_SECRET=changez_cette_cle_secrete_longue_et_aleatoire_min_32_chars
JWT_EXPIRES_IN=7d

# ── Email (pour récupération mot de passe) ───────────
# Configuration Gmail (recommandé)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre.email@gmail.com
EMAIL_PASS=votre_mot_de_passe_application_gmail
EMAIL_FROM="Saveurs du Cameroun <votre.email@gmail.com>"

# ── Frontend URL (pour les liens dans les emails) ────
FRONTEND_URL=http://localhost:5173
