# Configuration du serveur
PORT=3000
NODE_ENV=development

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=j_apprends_cuisiner
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe

# JWT
JWT_SECRET=votre-secret-jwt-tres-securise-changez-moi
JWT_EXPIRE=7d

# Session
SESSION_SECRET=votre-secret-session-tres-securise-changez-moi

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Facebook OAuth
# Créez une app Facebook sur https://developers.facebook.com/
FACEBOOK_APP_ID=votre_facebook_app_id
FACEBOOK_APP_SECRET=votre_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# Configuration Email (pour récupération de mot de passe)
# Pour Gmail: Activez "Accès moins sécurisé" ou utilisez un mot de passe d'application
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre-email@gmail.com
EMAIL_PASSWORD=votre-mot-de-passe-application
EMAIL_FROM=noreply@japprends-cuisiner.com
